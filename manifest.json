{
  "manifest_version": 3,
  "name": "Monash Moodle Downloader",
  "version": "4.7.1",
  "description": "Unofficial tool, not affiliated with Monash University. Batch-download Moodle course files, organized by section.",
  "permissions": [
    "downloads",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://learning.monash.edu/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://learning.monash.edu/*"],
      "js": [
        "lib/shared.js",
        "lib/moodle-page.js",
        "lib/download-plan.js",
        "lib/resource-resolver.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
